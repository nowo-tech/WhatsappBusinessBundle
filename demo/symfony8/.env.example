# Demo environment template. Copy to .env (e.g. cp .env.example .env) and adjust.
# Do not commit .env or local .env* files.

# APP_ENV: Symfony environment used by the demo container.
APP_ENV=dev

# APP_SECRET: local development secret placeholder.
APP_SECRET=change_this_secret_key_to_a_random_value

# APP_DEBUG: enable detailed debug output for local development.
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# PORT: HTTP port exposed by docker-compose for this demo.
PORT=8031

# TRUSTED_PROXIES: proxies trusted by Symfony behind Docker/Caddy.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# DEFAULT_URI: default router URI used by Symfony routing components.
DEFAULT_URI=http://localhost

# WHATSAPP_PHONE_NUMBER_ID: Cloud API phone number id (demo uses mock transport; placeholder is enough).
WHATSAPP_PHONE_NUMBER_ID=demo-phone

# WHATSAPP_ACCESS_TOKEN: Cloud API access token. Never commit a real token.
WHATSAPP_ACCESS_TOKEN=demo-token

# WHATSAPP_BUSINESS_ACCOUNT_ID: WABA id used for template listing (optional on mock).
WHATSAPP_BUSINESS_ACCOUNT_ID=demo-waba

# WHATSAPP_APP_SECRET: Meta app secret for X-Hub-Signature-256 (leave empty with mock + allow_unsigned_webhooks).
WHATSAPP_APP_SECRET=

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Token expected on GET hub.verify_token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=demo-verify
