{% extends 'base.html.twig' %}

{% block title %}WhatsApp Business Bundle — Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'WhatsappBusinessBundle',
        intro: 'FrankenPHP worker-safe Cloud API client',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Client profile', intro: 'Profile timeouts (REQ-RUNTIME-001).', kind: 'detail', testid: 'demo-profile'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--neutral">{{ version_badge }}</span>{% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">timeout</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">timeout={{ timeout }}s</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">connect_timeout</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">connect_timeout={{ connect_timeout }}s</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">transport</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">transport={{ transport }}</code></dd></div>
            </dl>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Send a text', kind: 'form', testid: 'demo-form'} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'send-form', class: 'nowo-ui-form'}}) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="send-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}

    {% if message_id %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Result', kind: 'detail', testid: 'demo-result'} %}
            {% block section_body %}
                <p>Message id: <code class="nowo-ui-code">{{ message_id }}</code></p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Webhook', kind: 'content'} %}
        {% block section_body %}
            <p>GET/POST <code class="nowo-ui-code">/whatsapp/webhook</code> (unsigned allowed in this mock demo).</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
