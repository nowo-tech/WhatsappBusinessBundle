# PHPStan configuration for WhatsApp Business Bundle.
#
# Static analysis on src/ and tests/ (level 8).
# Run: make phpstan
parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - vendor/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    # REQ-CS-006: never silence findings — fix the code instead (no baseline file).
    ignoreErrors: []

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
